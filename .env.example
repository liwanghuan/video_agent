# Local development: copy to .env and fill in the values you use.

# Idea generation (step 00) uses Claude with web search.
ANTHROPIC_API_KEY=
# IDEAS_MODEL_ID=claude-opus-5-5

GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL_ID=veo-3.1-fast-generate-001
VERTEX_OUTPUT_URI=gs://your-video-bucket/framehouse/

# A Qwen3-TTS voice-cloning service that accepts JSON:
# { "text": "...", "voice": "Xiaoyi", "format": "mp3" }
# It should return audio/mpeg bytes or JSON { "audioBase64": "..." }.
QWEN_TTS_ENDPOINT=https://your-qwen-service.example/generate
# Optional bearer token for the Qwen service.
# QWEN_TTS_TOKEN=

PORT=5173
